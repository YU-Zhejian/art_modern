---
Checks:
  # Enable all checks by default and disable some of them.
  - '*'

  # This warning is nonsense.
  - -readability-identifier-length

  # As we're not using LLVM LibC
  - -llvmlibc-*

  # We use magic numbers for some constants that are associated with specific
  # bioinformatics file formats & algorithms & conventions that appears only once.
  - -cppcoreguidelines-avoid-magic-numbers
  - -readability-magic-numbers

  # For C headers, we use our own format of header guard
  # For C++ headers, we use `#pragma once` which is implemented in almost all C++ compilers.
  - -llvm-header-guard
  - -portability-avoid-pragma-once

  # This warning is nonsense.
  - -bugprone-easily-swappable-parameters

  # This warning is nonsense.
  - -cppcoreguidelines-avoid-do-while

  # This warning is nonsense.
  - -readability-math-missing-parentheses

  # We used C arrays (and pointer arithmetics) to improve performance.
  - -*-avoid-c-arrays
  - -cppcoreguidelines-pro-bounds-constant-array-index
  - -cppcoreguidelines-pro-bounds-pointer-arithmetic
  - -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access

  # This warning generates wierd code.
  - -modernize-use-trailing-return-type

  # As we're only using std::endl in user-interface-related IO,
  # using std::endl is acceptable.
  - -performance-avoid-endl

  # This warning is nonsense.
  - -fuchsia-overloaded-operator

  # We do not use LLVM
  - -llvm-use-ranges

  # This warning is nonsense.
  # Those FORTRAN people write functions with thousands lines of code.
  - -readability-function-cognitive-complexity

  # We use this function to preserve some historical code in case
  # our own implementation fails.
  - -readability-avoid-unconditional-preprocessor-if

  # We allow default atguments.
  - -fuchsia-default-arguments-*

  # In compiler we trust.
  - -altera-unroll-loops
  - -altera-id-dependent-backward-branch

  # Const and reference data members silently delete copy- and move-assignment, which is a real hazard for
  # types that are expected to be assignable. The overwhelming majority of hits here are intentional `const`
  # value members on types that already delete their copy and move operations, so this check is disabled and
  # the reference-typed members are reviewed by hand instead. Note that the check already stays silent on
  # classes that explicitly delete both copy and move.
  - -cppcoreguidelines-avoid-const-or-ref-data-members

  # This check flags NON-private (i.e. public or protected) member variables; it recommends that members be
  # private. It is left enabled, but configured below via
  # misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic so that plain
  # immutable data carriers such as PairwiseAlignment are not reported. What remains is protected state on
  # base classes, which is the case C++ Core Guidelines C.133 actually cares about.

  # Globals with dynamic initialization have unspecified initialization order across translation units, and a
  # throwing constructor on such an object cannot be caught. cert-err58-cpp is left enabled to keep header
  # globals constexpr. fuchsia-statically-constructed-objects reports the same thing but more aggressively, so
  # only the CERT one is kept.
  - -fuchsia-statically-constructed-objects

  # Decaying an array to a pointer loses the size, so nothing downstream can bounds-check. The prescribed fix
  # is gsl::span, and we do not use GSL (see cppcoreguidelines-owning-memory below). Practically every hit is
  # a string literal being passed to HTSLib or Boost.program_options, so this is permanently disabled.
  - -cppcoreguidelines-pro-bounds-array-to-pointer-decay
  - -*-no-array-decay

  # We do not use Abseil.
  - -abseil-*

  # We minimize the use of Boost.
  # Those checks would suggest boost replacements over STL, so disabled.
  - -boost-use-*

  # This prevents us from using several HTSLib functions, so we disable it.
  - -*vararg

  # Sometimes we use goto for error handling.
  - -*-avoid-goto

  # We have no GSLs
  - -cppcoreguidelines-owning-memory

  # Numerous third-party header files violates this warning.
  # So disabled to avoid false positives.
  - -hicpp-signed-bitwise

  # Seems there's no other people who's maintaining the code.
  - -google-readability-todo

  # Memory management by hand of temporary objects are needed
  # to interact with third-party C libraries.
  - -*-no-malloc

  # Commonly used in tests and entry points
  - -google-build-using-namespace

  # HTSLib uses unions in several places.
  - -cppcoreguidelines-pro-type-union-access

  # snprintf_s is not available in all platforms.
  - -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling

  # 've been using anonymous namespace for internal linkage for a long time.
  - -llvm-prefer-static-over-anonymous-namespace

  # Using list of defines looks better than ifdef and elif defines.
  - -*-use-concise-preprocessor-directives

WarningsAsErrors: ''
HeaderFilterRegex: ''
FormatStyle: webkit

CheckOptions:
  - key: misc-include-cleaner.IgnoreHeaders
    value: 'mkl.*\.h;boost/.*/details/.*;boost/test/.*.cstdint;cstddef;fmt/format.h'
  # Types whose member variables are all public are plain data carriers (e.g. PairwiseAlignment); making them
  # private would only add getters. Protected members, which this still reports, are the actual concern.
  - key: misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value: 'true'

HeaderFileExtensions:
  - h
  - hh
ImplementationFileExtensions:
  - c
  - cc
...

